      "type": "string",
      "description": "ID dell'azienda proprietaria"
    },
    "product_id": {
      "type": "string",
      "description": "ID del prodotto"
    },
    "quantity": {
      "type": "number",
      "description": "Quantit\u00e0 disponibile attualmente"
    },
    "min_threshold": {
      "type": "number",
